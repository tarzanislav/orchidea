# SKLENÍK – jadro pre Tanix TX68 (Allwinner H618, R118): hlavné jadro Linux (kernel.org, dlhodobá podpora).
# Postup v CI: `make defconfig` → vypnú sa platformy iných výrobcov (zostane Allwinner sunxi) →
# pridá sa sklenik/jadro.config (spoločné nastavenie SKLENÍKA) → tento súbor.

# SKLENÍK moduly nenahráva: bez modulov sa všetko z nastavenia výrobcu zabuduje priamo do jadra
# CONFIG_MODULES is not set

# ovládače krabičky Tanix TX68 / Transpeed 8K618-T (zapísané výslovne, aby kontrola ukázala, že sú v jadre)
# hodiny, piny, DMA, správca napájania AXP313A na zbernici I2C
CONFIG_SUN50I_H616_CCU=y
CONFIG_PINCTRL_SUN50I_H616=y
CONFIG_PINCTRL_SUN50I_H616_R=y
CONFIG_DMA_SUN6I=y
CONFIG_I2C_MV64XXX=y
CONFIG_MFD_AXP20X_I2C=y
CONFIG_REGULATOR_AXP20X=y
# karta SD a eMMC
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SUNXI=y
# USB 2.0 (klávesnica, myš, USB kľúč) – všetky štyri radiče, TX68 má zásuvky aj na druhom páre
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_MUSB_SUNXI=y
# teplota a takt procesora (strážca KLÍČ), napätie podľa výrobnej triedy čipu (eFuse)
CONFIG_SUN8I_THERMAL=y
CONFIG_ARM_ALLWINNER_SUN50I_CPUFREQ_NVMEM=y
CONFIG_CPUFREQ_DT=y
CONFIG_NVMEM_SUNXI_SID=y
# strážny časovač (R99) a hodiny reálneho času
CONFIG_SUNXI_WATCHDOG=y
CONFIG_RTC_DRV_SUN6I=y

# obraz HDMI pre H616/H618 hlavné jadro zatiaľ nemá (chýba popis aj ovládač fyzickej vrstvy) – SKLENÍK beží
# bez obrazovky a stav ukazuje na kontrolkách klávesnice (R119); grafika preč, menšie a chladnejšie jadro
# CONFIG_DRM is not set
# zatiaľ nie (rovnako ako na RPi): Wi-Fi, Bluetooth, zvuk, kamery a video
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# serverové a priemyselné veci, ktoré krabička nepotrebuje
# CONFIG_ACPI is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_XEN is not set
# CONFIG_CAN is not set
# CONFIG_INFINIBAND is not set
# štíhle jadro (R97): H618 nemá PCI Express; veľké súborové systémy serverov a sieťové disky; ftrace
# CONFIG_PCI is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set
# CONFIG_FTRACE is not set

# samomeranie (R122): zápis na oddiel FAT karty (zapísané výslovne, aby kontrola overila, že sú v jadre)
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
