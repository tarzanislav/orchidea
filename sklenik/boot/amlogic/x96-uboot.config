# SKLENIK - X96 Max Plus: doplnky k nasmu U-Bootu (u-boot.ext). Krabicka casto startuje z USB kluca
# (slot karty nedrzi), preto: citanie USB klucov, USB ako prve a napis na obrazovke, co sa deje.
CONFIG_USB_STORAGE=y
CONFIG_CMD_USB=y
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y
CONFIG_CMD_EXT4=y
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="echo; echo SKLENIK: hladam system na USB kluci a karte ...; usb start; usb storage; setenv boot_targets usb0 mmc0 mmc1; run distro_bootcmd; bootflow scan -lb; echo; echo SKLENIK: system sa nenasiel - skuste druhy port USB alebo kartu"
