# SKLENÍK – jadro pre Odroid C4 (Amlogic S905X3, R88): hlavné jadro Linux (kernel.org, dlhodobá podpora).
# Postup v CI: `make defconfig` → vypnú sa platformy iných výrobcov (zostane Amlogic Meson) →
# pridá sa sklenik/jadro.config (spoločné nastavenie SKLENÍKA) → tento súbor.

# SKLENÍK moduly nenahráva: bez modulov sa všetko z nastavenia výrobcu zabuduje priamo do jadra
# CONFIG_MODULES is not set

# ovládače dosky Odroid C4 (zapísané výslovne, aby kontrola ukázala, že sú v jadre)
# karta SD a eMMC
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MESON_GX=y
# obrazovka HDMI cez vlastný ovládač grafiky Amlogic a /dev/fb0 pre KLÍČ
CONFIG_DRM=y
CONFIG_DRM_MESON=y
CONFIG_DRM_MESON_DW_HDMI=y
CONFIG_DRM_DISPLAY_CONNECTOR=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_DEVICE=y
# obrazovku nastaví ovládač grafiky sám – jednoduchá obrazovka od zavádzača by sa pri prevzatí stratila
# CONFIG_FB_SIMPLE is not set
# CONFIG_DRM_SIMPLEDRM is not set
# Ethernet 1 Gb/s (Realtek RTL8211F)
CONFIG_STMMAC_ETH=y
CONFIG_DWMAC_MESON=y
CONFIG_MDIO_BUS_MUX_MESON_G12A=y
CONFIG_REALTEK_PHY=y
# čipy siete TV krabičiek S905X3: Motorcomm YT8521/YT8531 (gigabit), vnútorný 100 Mb/s čip Amlogic, IC Plus
CONFIG_MOTORCOMM_PHY=y
CONFIG_MESON_GXL_PHY=y
CONFIG_ICPLUS_PHY=y
# USB 3.0 (rozbočovač na doske) a USB 2.0
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_MESON_G12A=y
CONFIG_PHY_MESON_G12A_USB2=y
CONFIG_PHY_MESON_G12A_USB3_PCIE=y
CONFIG_USB_ONBOARD_DEV=y
# teplota a takt procesora (strážca KLÍČ)
CONFIG_AMLOGIC_THERMAL=y
CONFIG_CPUFREQ_DT=y
CONFIG_PWM_MESON=y
CONFIG_REGULATOR_PWM=y
# R158: diaľkový ovládač TV krabičky (infračervený prijímač Amlogic, protokol NEC, mapa tlačidiel rc-x96max) –
# prebúdza zhasnutý obraz; neskôr ním bude ORCHIDEA ovládať prehrávanie videa
CONFIG_RC_CORE=y
CONFIG_RC_MAP=y
CONFIG_RC_DECODERS=y
CONFIG_IR_NEC_DECODER=y
CONFIG_RC_DEVICES=y
CONFIG_IR_MESON=y
# R162: merač toku pamäte DDR (počítadlá radiča pamäte Amlogic G12/SM1 cez perf) – KLÍČ ho číta vlastným kódom
CONFIG_PERF_EVENTS=y
CONFIG_MESON_DDR_PMU=y
# R166: merač taktov v čipe (skutočný takt VPU, PLL pamäte, bodu HDMI – debugfs meson-clk-msr); bol aj v karte
# 4edb1db, ktorá na televízore fungovala
CONFIG_MESON_CLK_MEASURE=y
# R165: video – hardvérový dekodér Amlogic cez V4L2 (H.264 a VP9 do 4K, MPEG-1/2 do Full HD; HEVC vlastným
# kódom SKLENÍKA). Firmvér dekodéra (mikrokód jeho procesora AMRISC, linux-firmware) NIE JE v jadre – licencia
# LICENSE.amlogic_vdec to nedovoľuje; je na karte v amlogic/vdec/ a KLÍČ ho pri štarte dá do /lib/firmware.
# Len dekodér: bez kamier, TV tunerov, rádií, CEC a GE2D.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
# CONFIG_MEDIA_CAMERA_SUPPORT is not set
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_RADIO_SUPPORT is not set
# CONFIG_MEDIA_SDR_SUPPORT is not set
# CONFIG_MEDIA_TEST_SUPPORT is not set
# CONFIG_MEDIA_USB_SUPPORT is not set
# R180: CEC MUSÍ ostať (ovládač meson-ao-cec-g12a): bez neho ostane vývod CEC v HDMI bez ovládača a televízor
# (VES 43UHD) nedá obraz – „Nie je signál“; monitor cez redukciu HDMI→VGA CEC nepoužíva, preto to tam nebolo
# vidno. Chyba prišla s R165 (780906f), keď zoznam médií vypol aj CEC.
CONFIG_MEDIA_CEC_SUPPORT=y
# CONFIG_MEDIA_CONTROLLER is not set
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
# CONFIG_VIDEO_CADENCE_CSI2RX is not set
# CONFIG_VIDEO_MAX96712 is not set
# CONFIG_VIDEO_IR_I2C is not set
CONFIG_VIDEO_DEV=y
CONFIG_STAGING=y
CONFIG_STAGING_MEDIA=y
CONFIG_VIDEO_MESON_VDEC=y
# R225: ladiace hlásenia ovládačov zapínané za behu (KLÍČ ich zapne len počas skúšky H.264 – časové značky,
# posuny v toku, DPB); vypnuté nestoja nič
CONFIG_DYNAMIC_DEBUG=y
CONFIG_MESON_CANVAS=y
# CONFIG_VIDEO_MESON_GE2D is not set
# sériová linka (ladenie cez adaptér USB–TTL)
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y

# zatiaľ nie: Wi-Fi a Bluetooth – menšie a chladnejšie jadro
# CONFIG_WLAN is not set
# CONFIG_BT is not set
# R226: zvuk cez HDMI (prehrávač LÝRA): pamäť → FRDDR → TDM B → TOHDMITX → I2S do HDMI (dw-hdmi) – zvuková
# karta „axg-sound-card“ z popisu hardvéru Odroidu C4 aj X96 Air; takty zvuku a rozhodca pamäte zvuku. Bez
# prehrávania stojí (takty sa zapnú len pri prehrávaní). KLÍČ zahrá pri štarte krátky tón a zapíše výsledok.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_COMMON_CLK_AXG_AUDIO=y
CONFIG_RESET_MESON_AUDIO_ARB=y
CONFIG_SND_MESON_AXG_FRDDR=y
CONFIG_SND_MESON_AXG_TDM_INTERFACE=y
CONFIG_SND_MESON_AXG_TDMOUT=y
CONFIG_SND_MESON_AXG_SOUND_CARD=y
CONFIG_SND_MESON_G12A_TOHDMITX=y
CONFIG_DRM_DW_HDMI_I2S_AUDIO=y
CONFIG_SND_SOC_HDMI_CODEC=y
# zvuk, ktorý krabička nepotrebuje (nastavenie výrobcu by ho bez modulov zabudovalo do jadra)
# CONFIG_SND_ALOOP is not set
# CONFIG_SND_HDA_CODEC_HDMI is not set
# CONFIG_SND_MESON_GX_SOUND_CARD is not set
# CONFIG_SOUNDWIRE is not set
# grafické karty do PCI Express (Odroid C4 ho nemá vyvedené)
# CONFIG_DRM_AMDGPU is not set
# CONFIG_DRM_RADEON is not set
# CONFIG_DRM_NOUVEAU is not set
# serverové a priemyselné veci, ktoré doska nepotrebuje
# CONFIG_ACPI is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_XEN is not set
# CONFIG_CAN is not set
# CONFIG_INFINIBAND is not set

# R97 – štíhle jadro: preč všetko, čo Odroid C4 nemá alebo SKLENÍK nepotrebuje (každá MB = rýchlejší štart
# zo SD karty a viac voľnej RAM); veľkosť jadra ukáže kontrola v CI
# PCI Express C4 nemá vyvedené (zmizne aj NVMe, sieťové a grafické karty do PCIe)
# CONFIG_PCI is not set
# veľké súborové systémy serverov a sieťové disky
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set
# sledovanie funkcií jadra (ftrace) – aj vypnuté zaberá miesto a pridáva inštrukcie do každej funkcie
# CONFIG_FTRACE is not set

# samomeranie (R122): zápis na oddiel FAT karty (zapísané výslovne, aby kontrola overila, že sú v jadre)
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# R238: zaseknutie jadra = reštart s dôkazom namiesto zamrznutia. Odroid C4 26. 11. prestal zapisovať po 30. minúte
# merania a nereštartoval sa – nevedno prečo. Teraz: jadro zaseknuté v cykle (soft/hard lockup, 20/10 s) alebo úloha
# zaseknutá v stave D (napr. na karte SD, 120 s) → panika → reštart (panic=5); celý denník jadra s výpisom zásobníka
# zostane v záznamníku pádov (dmesg-ramoops) a KLÍČ ho po štarte zapíše do merania.
CONFIG_DEBUG_KERNEL=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=y
