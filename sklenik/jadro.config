# SKLENÍK – úpravy oficiálneho jadra Raspberry Pi. Pridávajú sa k nastaveniu výrobcu pre každý model:
# bcmrpi_defconfig (RPi 1, Zero), bcm2709_defconfig (RPi 2), bcm2711_defconfig (RPi 3, Zero 2 W, 4)
# a bcm2712_defconfig (RPi 5). Voľby, ktoré pre daný procesor neexistujú, jadro vynechá.
# Cieľ: chladné a svižné zariadenie s pasívnym chladením; celý systém v pamäti.

# nečinnosť bez zbytočného prebúdzania (jadrá spia, kým nie je práca)
CONFIG_NO_HZ_IDLE=y
CONFIG_CPU_IDLE=y

# regulácia taktu: schedutil – rýchla odozva pri práci, najnižší takt v nečinnosti
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ARM_RASPBERRYPI_CPUFREQ=y

# snímače teploty zabudované priamo v jadre (strážca ich potrebuje hneď po štarte)
CONFIG_THERMAL=y
CONFIG_BCM2835_THERMAL=y
CONFIG_BCM2711_THERMAL=y
CONFIG_BRCMSTB_THERMAL=y

# vypínanie jadier tam, kde to platforma dovolí
CONFIG_HOTPLUG_CPU=y

# celý systém v pamäti (initramfs), zariadenia v /dev bez pomocných programov
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# obrazovka od firmvéru a textová konzola pre stav KLÍČA
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# R190: obraz cez vlastný ovládač KLÍČA – KMS (vc4) priamo v jadre: chladný obraz, vypnuté HDMI v pokoji, CEC.
# Zapína ho prekrytie vc4-kms-v3d v sklenik-obraz.txt; bez neho ostáva obrazovka od firmvéru. Grafický
# procesor V3D (RPi 4, 5) ostáva modulom – SKLENÍK moduly nenahráva, GPU nehreje.
CONFIG_DRM=y
CONFIG_DRM_VC4=y
CONFIG_DRM_VC4_HDMI_CEC=y
# R217: RPi 0–3 – HDMI (vc4) číta popis monitora cez zbernicu I2C čipu BCM2835; v nastavení výrobcu je to modul,
# ktorý KLÍČ nenahráva → ovládač obrazu čakal naveky („deferred probe pending“) a TV hlásil „žiadny signál“
# (RPi 3B+ 24. 11. 2026). RPi 4 a 5 majú vlastnú zbernicu HDMI, tých sa to netýka.
CONFIG_I2C=y
CONFIG_I2C_BCM2835=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SND=y
CONFIG_SND_SOC=y

# periférie zapnuté hneď pri štarte – ovládače priamo v jadre, nie ako moduly (SKLENÍK moduly nenahráva):
# klávesnica, myš, dotyk cez USB
CONFIG_INPUT_EVDEV=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_USB_HID=y
# USB disky a čítačky kariet
CONFIG_USB_STORAGE=y
# Ethernet každého modelu: RPi 1 B/B+, 2, 3 B (SMSC LAN9514), 3 B+ (LAN7515), 4 (GENET), 5 (RP1 – MACB)
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_SMSC95XX=y
CONFIG_USB_LAN78XX=y
CONFIG_BCMGENET=y
CONFIG_MACB=y
# obvody fyzickej vrstvy Ethernetu (RPi 4 a 5 – Broadcom, RPi 3 B+ – Microchip)
CONFIG_PHYLIB=y
CONFIG_BROADCOM_PHY=y
CONFIG_MICROCHIP_PHY=y
# Ethernet cez USB kábel z počítača (USB adaptéry a režim USB gadget neskôr – KORENE)
CONFIG_USB_NET_CDCETHER=y

# napájanie: hlásenie podpätia od firmvéru (slabý zdroj) – KLÍČ ho ukáže na obrazovke
CONFIG_HWMON=y
CONFIG_SENSORS_RASPBERRYPI_HWMON=y

# menšie jadro, rýchlejšie zostavenie
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_IKHEADERS is not set
CONFIG_LOCALVERSION="-sklenik"

# stlačená pamäť zram (R94) – na doskách s ≤ 1 GB RAM ju zapne KLÍČ (rýchly kompresor lz4)
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y

# samomeranie (R122): KLÍČ zapisuje výsledky skúšky do priečinka MERANIA na oddiele FAT karty (vidí ho aj
# Windows); znakové sady zabudované do jadra – moduly SKLENÍK nenahráva a bez nich by sa oddiel nepripojil
CONFIG_MSDOS_PARTITION=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# R216: záznamník pádov – pamäť, ktorá prežije reštart (pstore/ramoops). Jadro do nej píše hlásenia pri páde
# a svoju konzolu, KLÍČ svoje riadky (/dev/pmsg0). Po nečakanom reštarte KLÍČ posledné riadky ukáže v zázname.
# Pamäť vyhradzuje popis hardvéru (Amlogic: uzol ramoops v reserved-memory); bez neho sa nič nedeje.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# R247: zberač meraní (LOVEC ZBERAČ) – krabička nájde počítač v miestnej sieti cez adresy IPv6 miestnej linky
# (fe80::, ff02::1) bez routera, DHCP a nastavovania IP adries; prenos TCP
CONFIG_INET=y
CONFIG_IPV6=y
