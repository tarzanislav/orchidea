diff --git a/drivers/staging/media/meson/vdec/esparser.c b/drivers/staging/media/meson/vdec/esparser.c
index 4632346f0..730330213 100644
--- a/drivers/staging/media/meson/vdec/esparser.c
+++ b/drivers/staging/media/meson/vdec/esparser.c
@@ -265,6 +265,13 @@ int esparser_queue_eos(struct amvdec_core *core, const u8 *data, u32 len)
 		return -ENOMEM;
 
 	memcpy(eos_vaddr, data, len);
+	/*
+	 * SKLENÍK (R174): za dáta vyhľadávací vzor ako pri bežných buffroch (esparser_pad_start_code). Bez neho
+	 * parser vzor nenašiel, zápis po 200 ms vypršal (vrátil 0) a koniec toku nebol potvrdený.
+	 */
+	memset(eos_vaddr + len, 0, SEARCH_PATTERN_LEN);
+	((u8 *)eos_vaddr)[len + 2] = 0x01;
+	((u8 *)eos_vaddr)[len + 3] = 0xff;
 	ret = esparser_write_data(core, eos_paddr, len);
 	dma_free_coherent(dev, len + SEARCH_PATTERN_LEN,
 			  eos_vaddr, eos_paddr);
@@ -308,7 +315,8 @@ esparser_queue(struct amvdec_session *sess, struct vb2_v4l2_buffer *vbuf)
 	 * they could pause when there is no capture buffer available and
 	 * resume on this notification.
 	 */
-	if (sess->fmt_out->pixfmt == V4L2_PIX_FMT_VP9) {
+	if (sess->fmt_out->pixfmt == V4L2_PIX_FMT_VP9 ||
+	    sess->fmt_out->pixfmt == V4L2_PIX_FMT_HEVC) {
 		if (codec_ops->num_pending_bufs)
 			num_dst_bufs = codec_ops->num_pending_bufs(sess);
 
@@ -383,6 +391,24 @@ void esparser_queue_all_src(struct work_struct *work)
 		if (esparser_queue(sess, &buf->vb) < 0)
 			break;
 	}
+	/*
+	 * SKLENÍK (R174): po príkaze STOP sa najprv zapíšu všetky buffre zaradené pred ním (V4L2 dekodér so stavom),
+	 * až potom raz koniec toku – v tom istom vlákne, teda v poradí za dátami a nikdy súbežne s iným zápisom.
+	 */
+	if (sess->sklenik_stop && !sess->should_stop &&
+	    !v4l2_m2m_num_src_bufs_ready(sess->m2m_ctx)) {
+		struct amvdec_codec_ops *codec_ops = sess->fmt_out->codec_ops;
+
+		sess->should_stop = 1;
+		if (codec_ops->sklenik_koniec_toku) {
+			codec_ops->sklenik_koniec_toku(sess);
+		} else if (codec_ops->eos_sequence) {
+			u32 len;
+			const u8 *data = codec_ops->eos_sequence(&len);
+
+			esparser_queue_eos(sess->core, data, len);
+		}
+	}
 	mutex_unlock(&sess->lock);
 }
 
diff --git a/drivers/staging/media/meson/vdec/vdec.c b/drivers/staging/media/meson/vdec/vdec.c
index 49df5c639..aa5df2abb 100644
--- a/drivers/staging/media/meson/vdec/vdec.c
+++ b/drivers/staging/media/meson/vdec/vdec.c
@@ -323,6 +323,7 @@ static int vdec_start_streaming(struct vb2_queue *q, unsigned int count)
 	}
 
 	sess->should_stop = 0;
+	sess->sklenik_stop = 0;
 	sess->keyframe_found = 0;
 	sess->last_offset = 0;
 	sess->wrap_count = 0;
@@ -723,6 +724,7 @@ vdec_decoder_cmd(struct file *file, void *fh, struct v4l2_decoder_cmd *cmd)
 	if (cmd->cmd == V4L2_DEC_CMD_START) {
 		v4l2_m2m_clear_state(sess->m2m_ctx);
 		sess->should_stop = 0;
+		sess->sklenik_stop = 0;
 		return 0;
 	}
 
@@ -732,6 +734,18 @@ vdec_decoder_cmd(struct file *file, void *fh, struct v4l2_decoder_cmd *cmd)
 
 	dev_dbg(dev, "Received V4L2_DEC_CMD_STOP\n");
 
+	if (codec_ops->sklenik_koniec_toku || codec_ops->eos_sequence) {
+		/*
+		 * SKLENÍK (R174): pôvodne should_stop = 1 hneď – buffre ešte v rade sa už nezapísali do toku, posledné
+		 * snímky (aj EOS programu) dekodér nedostal. Zapíše ich esparser_queue_all_src, potom koniec toku.
+		 * Od 27. 11. aj H.264 a MPEG-1/2 (eos_sequence); VP9 (drain) ostáva po starom.
+		 */
+		sess->sklenik_stop = 1;
+		v4l2_m2m_mark_stopped(sess->m2m_ctx);
+		schedule_work(&sess->esparser_queue_work);
+		return ret;
+	}
+
 	sess->should_stop = 1;
 
 	v4l2_m2m_mark_stopped(sess->m2m_ctx);
diff --git a/drivers/staging/media/meson/vdec/vdec.h b/drivers/staging/media/meson/vdec/vdec.h
index 7a5d8e871..bf453d231 100644
--- a/drivers/staging/media/meson/vdec/vdec.h
+++ b/drivers/staging/media/meson/vdec/vdec.h
@@ -138,6 +138,8 @@ struct amvdec_codec_ops {
 	void (*drain)(struct amvdec_session *sess);
 	void (*resume)(struct amvdec_session *sess);
 	const u8 * (*eos_sequence)(u32 *len);
+	/* SKLENÍK (R174): koniec toku po príkaze STOP – volá sa raz, keď sú zapísané všetky zaradené buffre */
+	void (*sklenik_koniec_toku)(struct amvdec_session *sess);
 	irqreturn_t (*isr)(struct amvdec_session *sess);
 	irqreturn_t (*threaded_isr)(struct amvdec_session *sess);
 };
@@ -255,6 +257,8 @@ struct amvdec_session {
 	unsigned int streamon_cap, streamon_out;
 	unsigned int sequence_cap, sequence_out;
 	unsigned int should_stop;
+	/* SKLENÍK (R174): STOP prijatý, zaradené buffre sa ešte zapisujú (kodek so sklenik_koniec_toku) */
+	unsigned int sklenik_stop;
 	unsigned int keyframe_found;
 	unsigned int num_dst_bufs;
 	unsigned int changed_format;
