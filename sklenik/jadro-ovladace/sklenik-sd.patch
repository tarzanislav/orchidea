 		err = sd_read_ext_regs(card);
-		if (err)
-			goto free_card;
+		if (err) {
+			/*
+			 * SKLENÍK (R189): rozširujúce registre sú voliteľné (vyrovnávacia pamäť karty, oznámenie
+			 * vypnutia). Karta, ktorá ich neprečíta, je inak v poriadku – nezahodiť ju, len ich nepoužiť.
+			 */
+			pr_warn("%s: SD ext reg nečitateľné (%d) – karta bez rozšírení (R189)\n",
