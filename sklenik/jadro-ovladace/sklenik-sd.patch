+/*
+ * SKLENÍK (R189): niektoré lacné karty SD na niektorých doskách (Odroid C4 + Taishin SD64G) pri 50 MHz vracajú
+ * chyby CRC. KLÍČ po opakovaných zlyhaniach nastaví nižší strop taktu a radič znova pripojí. 0 = bez stropu.
+ */
+static unsigned int sklenik_sd_max_khz;
+module_param(sklenik_sd_max_khz, uint, 0644);
+MODULE_PARM_DESC(sklenik_sd_max_khz, "strop taktu karty SD v kHz (R189, 0 = bez stropu)");
+
 unsigned mmc_sd_get_max_clock(struct mmc_card *card)
 {
 	unsigned max_dtr = (unsigned int)-1;
+	unsigned int strop = READ_ONCE(sklenik_sd_max_khz);
+
+	if (strop && max_dtr > strop * 1000)
+		max_dtr = strop * 1000;
 
 	if (mmc_card_hs(card)) {
 		if (max_dtr > card->sw_caps.hs_max_dtr)
@@ -1573,8 +1586,17 @@
 	if (!oldcard) {
